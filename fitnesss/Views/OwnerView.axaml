<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="fitnesss.Views.OwnerWindow"
        x:CompileBindings="False"
        Title="Owner - Lontar Gym"
        Width="1050" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- TOP NAVBAR -->
        <Border Grid.Row="0" Background="#0F172A" Padding="16,12" BoxShadow="0 2 8 0 #15000000">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="🏋️ LONTAR GYM" FontSize="18" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                    <TextBlock Text="|" FontSize="18" Foreground="#475569"/>
                    <TextBlock Text="Executive Dashboard (Owner)" FontSize="15" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="20" Padding="12,5" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="👑 Owner:" FontSize="12" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtOwnerName" Text="Pemilik Lontar Gym" FontSize="12" FontWeight="Bold" Foreground="#FBBF24"/>
                        </StackPanel>
                    </Border>

                    <Button Content="🚪 Logout" Click="BtnLogout_Click" Background="#EF4444" Foreground="White" FontWeight="SemiBold" Padding="12,6" CornerRadius="6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SUMMARY CARDS -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *, *" Margin="16,16,16,0">
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0" BoxShadow="0 1 3 0 #10000000">
                <StackPanel Spacing="4">
                    <TextBlock Text="💰 Total Omset Transaksi" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtSummaryOmset" Text="Rp 0" FontSize="20" FontWeight="ExtraBold" Foreground="#16A34A"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="4,0,4,0" BoxShadow="0 1 3 0 #10000000">
                <StackPanel Spacing="4">
                    <TextBlock Text="🧾 Total Transaksi" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtSummaryTrxCount" Text="0 Transaksi" FontSize="20" FontWeight="ExtraBold" Foreground="#2563EB"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" Margin="8,0,0,0" BoxShadow="0 1 3 0 #10000000">
                <StackPanel Spacing="4">
                    <TextBlock Text="📜 Total Aktivitas Log" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtSummaryLogCount" Text="0 Aktivitas" FontSize="20" FontWeight="ExtraBold" Foreground="#D97706"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MAIN TABS -->
        <Border Grid.Row="2" Margin="16" Background="White" CornerRadius="10" Padding="16" BoxShadow="0 1 4 0 #10000000">
            <TabControl>
                <!-- TAB 1: LAPORAN TRANSAKSI & FILTERING -->
                <TabItem Header="📊 Laporan Transaksi">
                    <StackPanel Spacing="12" Margin="0,10,0,0">
                        <!-- Filter Bar -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Mulai Tanggal:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#334155"/>
                                    <DatePicker x:Name="DpStart" Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock Text="Sampai Tanggal:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#334155"/>
                                    <DatePicker x:Name="DpEnd" Height="36"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="🔍 Terapkan Filter" Click="BtnFilter_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Height="36" Padding="14,0" Margin="16,0,0,0" CornerRadius="4"/>
                                <Button Grid.Column="3" Content="🔄 Reset" Click="BtnResetFilter_Click" Background="#64748B" Foreground="White" FontWeight="SemiBold" Height="36" Padding="14,0" Margin="8,0,0,0" CornerRadius="4"/>
                                <Button Grid.Column="4" Content="📄 Ekspor ke PDF" Click="BtnExportPdf_Click" Background="#DC2626" Foreground="White" FontWeight="Bold" Height="36" Padding="14,0" Margin="8,0,0,0" CornerRadius="4"/>

                                <TextBlock Grid.Column="5" x:Name="TxtFilterInfo" Text="Menampilkan semua transaksi" FontSize="12" FontWeight="SemiBold" Foreground="#0284C7" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="DgTransactions" Height="410" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                                <DataGridTextColumn Header="Waktu Transaksi" Binding="{Binding CreatedAt, StringFormat='{}{0:dd-MM-yyyy HH:mm}'}" Width="150"/>
                                <DataGridTextColumn Header="Pelanggan" Binding="{Binding NamaPelanggan}" Width="150"/>
                                <DataGridTextColumn Header="Nomor Unik" Binding="{Binding NomorUnik}" Width="110"/>
                                <DataGridTextColumn Header="Layanan / Produk" Binding="{Binding NamaProduk}" Width="*"/>
                                <DataGridTextColumn Header="Uang Bayar" Binding="{Binding UangBayar, StringFormat='Rp {0:N0}'}" Width="110"/>
                                <DataGridTextColumn Header="Uang Kembali" Binding="{Binding UangKembali, StringFormat='Rp {0:N0}'}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

                <!-- TAB 2: PENGECEKAN DATA PRODUK -->
                <TabItem Header="📋 Pengecekan Data Produk">
                    <StackPanel Spacing="12" Margin="0,10,0,0">
                        <TextBlock Text="Daftar Katalog Produk &amp; Layanan Lontar Gym" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                        <DataGrid x:Name="DgOwnerProducts" Height="460" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Nama Produk / Layanan" Binding="{Binding NamaProduk}" Width="*"/>
                                <DataGridTextColumn Header="Harga Produk (Rp)" Binding="{Binding HargaProduk, StringFormat='Rp {0:N0}'}" Width="180"/>
                                <DataGridTextColumn Header="Tanggal Dibuat" Binding="{Binding CreatedAt, StringFormat='{}{0:dd-MM-yyyy HH:mm}'}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

                <!-- TAB 3: PENGECEKAN LOG AKTIVITAS -->
                <TabItem Header="📜 Log Aktivitas Sistem">
                    <StackPanel Spacing="12" Margin="0,10,0,0">
                        <TextBlock Text="Riwayat Aktivitas Administrator &amp; Kasir (Audit Trail)" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                        <DataGrid x:Name="DgLogs" Height="460" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Log ID" Binding="{Binding Id}" Width="70"/>
                                <DataGridTextColumn Header="Waktu" Binding="{Binding CreatedAt, StringFormat='{}{0:dd-MM-yyyy HH:mm:ss}'}" Width="170"/>
                                <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="130"/>
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                                <DataGridTextColumn Header="Aktivitas" Binding="{Binding Activity}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
