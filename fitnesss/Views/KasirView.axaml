<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="fitnesss.Views.KasirWindow"
        x:CompileBindings="False"
        Title="Kasir POS - Lontar Gym"
        Width="1180" Height="740"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid RowDefinitions="Auto, *">
        <!-- TOP NAVBAR -->
        <Border Grid.Row="0" Background="#1E293B" Padding="16,10" BoxShadow="0 2 8 0 #15000000">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="🏋️ LONTAR GYM" FontSize="18" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                    <TextBlock Text="|" FontSize="18" Foreground="#475569"/>
                    <TextBlock Text="Kasir &amp; Point of Sale (POS)" FontSize="15" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#334155" CornerRadius="20" Padding="12,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="👤 Kasir:" FontSize="12" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtKasirName" Text="Kasir Utama" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>

                    <Button Content="🚪 Logout" Click="BtnLogout_Click" Background="#EF4444" Foreground="White" FontWeight="SemiBold" Padding="12,6" CornerRadius="6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN LAYOUT (2 KOLOM: KATALOG PRODUK + KERANJANG/CHECKOUT) -->
        <Grid Grid.Row="1" ColumnDefinitions="6*, 4*" Margin="14">
            
            <!-- KOLOM KIRI: KATALOG PRODUK (PENCET LANGSUNG ADD) -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16" BoxShadow="0 1 4 0 #10000000" Margin="0,0,12,0">
                <Grid RowDefinitions="Auto, Auto, *">
                    <!-- Header & Pencarian -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Pilih Produk &amp; Layanan" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Klik tombol '+ Tambah' atau klik produk untuk memasukkan ke keranjang" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🕒 Riwayat Transaksi Hari Ini" Click="BtnBukaRiwayat_Click" 
                                Background="#0284C7" Foreground="White" FontWeight="SemiBold" Height="34" Padding="12,0" CornerRadius="6"/>
                    </Grid>

                    <TextBox Grid.Row="1" x:Name="TxtSearchProduct" PlaceholderText="🔍 Cari nama produk atau layanan gym..." 
                             Height="38" TextChanged="TxtSearchProduct_TextChanged" Margin="0,0,0,12"/>

                    <!-- Grid Kartu Produk (ItemsControl dengan WrapPanel) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="IcProductCards">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Card Produk -->
                                    <Border Width="195" Height="150" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" 
                                            CornerRadius="8" Margin="0,0,12,12" Padding="12" BoxShadow="0 1 3 0 #08000000">
                                        <Grid RowDefinitions="Auto, *, Auto">
                                            <!-- Badge Kategori / ID -->
                                            <Border Grid.Row="0" Background="#E0F2FE" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Id, StringFormat='#PROD-{0}'}" FontSize="10" FontWeight="Bold" Foreground="#0369A1"/>
                                            </Border>

                                            <!-- Nama & Harga Produk -->
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6">
                                                <TextBlock Text="{Binding NamaProduk}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" MaxLines="2"/>
                                                <TextBlock Text="{Binding HargaProduk, StringFormat='Rp {0:N0}'}" FontSize="14" FontWeight="ExtraBold" Foreground="#16A34A" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Tombol Tambah Langsung -->
                                            <Button Grid.Row="2" Content="➕ Tambah" Tag="{Binding}" Click="BtnAddProduct_Click" 
                                                    Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12" 
                                                    Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="6"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- KOLOM KANAN: FORM MEMBER & KERANJANG TRANSAKSI (CART) -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16" BoxShadow="0 1 4 0 #10000000">
                <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
                    <!-- 1. Form Member -->
                    <StackPanel Grid.Row="0" Spacing="8">
                        <TextBlock Text="Data Pelanggan &amp; Member" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>

                        <!-- Nomor Unik Pelanggan / Member -->
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox x:Name="TxtNomorUnik" MaxLength="10" PlaceholderText="Nomor Unik / ID Member (Maks 10)..." Height="36" 
                                     TextChanged="TxtNomorUnik_TextChanged"/>
                            <Button Grid.Column="1" Content="🔍 Cek" Click="BtnCekMember_Click" Background="#0284C7" Foreground="White" 
                                    FontWeight="SemiBold" Height="36" Margin="6,0,0,0" Padding="12,0" CornerRadius="4"/>
                        </Grid>

                        <!-- Status Badge Member & Kuota Harian -->
                        <Border x:Name="BorderMemberStatus" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="TxtStatusBadge" Text="Status: Masukkan nomor unik untuk cek member" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                <TextBlock x:Name="TxtKuotaHarian" Text="* Gym Harian Gratis 1x/hari khusus Member" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- Nama Pelanggan -->
                        <TextBox x:Name="TxtNamaPelanggan" PlaceholderText="Nama Lengkap Pelanggan..." Height="36"/>
                    </StackPanel>

                    <Separator Grid.Row="1" Background="#E2E8F0" Margin="0,10"/>

                    <!-- 2. Header Keranjang -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                        <TextBlock Text="🛒 Keranjang Belanja" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        <Button Grid.Column="1" Content="Kosongkan" Click="BtnClearCart_Click" 
                                Background="#F1F5F9" Foreground="#64748B" FontSize="11" Padding="8,4" CornerRadius="4"/>
                    </Grid>

                    <!-- 3. Daftar Item di Keranjang (ScrollViewer DataGrid/List) -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="IcCartItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="8">
                                            <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                                <!-- Nama & Catatan Gratis -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding ProductName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Note}" FontSize="10" Foreground="#10B981" FontWeight="Medium" IsVisible="{Binding IsFreeMemberBenefit}"/>
                                                    <TextBlock Text="{Binding UnitPrice, StringFormat='@ Rp {0:N0}'}" FontSize="10" Foreground="#64748B"/>
                                                </StackPanel>

                                                <!-- Qty Controls: [-] [qty] [+] -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button Content="-" Tag="{Binding}" Click="BtnQtyMinus_Click" Width="24" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#E2E8F0" CornerRadius="4"/>
                                                    <TextBlock Text="{Binding Qty}" FontSize="12" FontWeight="Bold" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <Button Content="+" Tag="{Binding}" Click="BtnQtyPlus_Click" Width="24" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#E2E8F0" CornerRadius="4"/>
                                                </StackPanel>

                                                <!-- Subtotal -->
                                                <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='Rp {0:N0}'}" FontSize="12" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="8,0"/>

                                                <!-- Hapus Item -->
                                                <Button Grid.Column="3" Content="✕" Tag="{Binding}" Click="BtnRemoveItem_Click" Background="#FEE2E2" Foreground="#DC2626" Width="24" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="4"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 4. Total & Pembayaran -->
                    <StackPanel Grid.Row="4" Spacing="8" Margin="0,10,0,0">
                        <!-- Total Box -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="TOTAL TAGIHAN:" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TxtTotalTagihan" Text="Rp 0" FontSize="18" FontWeight="ExtraBold" Foreground="#1D4ED8"/>
                            </Grid>
                        </Border>

                        <!-- Input Uang Bayar -->
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                <TextBlock Text="Uang Bayar Tunai (Rp):" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox x:Name="TxtUangBayar" PlaceholderText="0" Height="36" TextChanged="TxtUangBayar_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                <TextBlock Text="Uang Kembali:" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Height="36" Padding="8,0">
                                    <TextBlock x:Name="LblUangKembali" Text="Rp 0" FontSize="13" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Error Message -->
                        <TextBlock x:Name="TxtErrorKasir" Text="" Foreground="#DC2626" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>

                        <!-- Action Button: Proses Transaksi & Cetak Struk -->
                        <Button Content="💾 PROSES TRANSAKSI &amp; CETAK STRUK" Click="BtnSimpanTrans_Click" 
                                Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="13" Height="44" 
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="6"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
