<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="fitnesss.Views.AdminWindow"
        x:CompileBindings="False"
        Title="Administrator - Lontar Gym"
        Width="1050" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid RowDefinitions="Auto, *">
        <!-- TOP NAVBAR -->
        <Border Grid.Row="0" Background="#0F172A" Padding="16,12" BoxShadow="0 2 8 0 #15000000">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="🏋️ LONTAR GYM" FontSize="18" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                    <TextBlock Text="|" FontSize="18" Foreground="#475569"/>
                    <TextBlock Text="Panel Administrator" FontSize="15" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="20" Padding="12,5" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🛡️ Admin:" FontSize="12" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtAdminName" Text="Administrator" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>

                    <Button Content="🚪 Logout" Click="BtnLogout_Click" Background="#EF4444" Foreground="White" FontWeight="SemiBold" Padding="12,6" CornerRadius="6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABS -->
        <Border Grid.Row="1" Margin="16" Background="White" CornerRadius="10" Padding="16" BoxShadow="0 1 4 0 #10000000">
            <TabControl>
                <!-- TAB 1: KELOLA PRODUK -->
                <TabItem Header="📦 Kelola Produk &amp; Layanan">
                    <Grid ColumnDefinitions="3.5*, 6.5*" Margin="0,12,0,0">
                        <!-- Form Produk -->
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Form Input Data Produk" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <Separator Background="#E2E8F0"/>

                                <TextBox x:Name="TxtIdProduk" IsVisible="False"/>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Nama Produk / Layanan:" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBox x:Name="TxtNamaProduk" PlaceholderText="Contoh: Member Bulanan / Gym Harian..." Height="36"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Harga Produk (Rp):" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBox x:Name="TxtHargaProduk" PlaceholderText="Contoh: 150000" Height="36"/>
                                </StackPanel>

                                <TextBlock x:Name="TxtStatusProduk" Text="" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" Margin="0,6,0,0">
                                    <Button Grid.Row="0" Grid.Column="0" Content="💾 Simpan Baru" Click="BtnSimpanProduk_Click" Background="#16A34A" Foreground="White" FontWeight="Bold" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,6" CornerRadius="4"/>
                                    <Button Grid.Row="0" Grid.Column="1" Content="✏️ Update" Click="BtnUpdateProduk_Click" Background="#D97706" Foreground="White" FontWeight="Bold" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,6" CornerRadius="4"/>
                                    <Button Grid.Row="1" Grid.Column="0" Content="🗑️ Hapus" Click="BtnHapusProduk_Click" Background="#DC2626" Foreground="White" FontWeight="Bold" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" CornerRadius="4"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="🔄 Reset" Click="BtnResetProduk_Click" Background="#64748B" Foreground="White" FontWeight="SemiBold" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0" CornerRadius="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Tabel Produk -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Daftar Produk Gym Tersedia (Klik baris tabel untuk edit)" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                                <DataGrid x:Name="DgAdminProducts" Height="470" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgAdminProducts_SelectionChanged" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                        <DataGridTextColumn Header="Nama Produk / Layanan" Binding="{Binding NamaProduk}" Width="*"/>
                                        <DataGridTextColumn Header="Harga (Rp)" Binding="{Binding HargaProduk, StringFormat='{}{0:N0}'}" Width="150"/>
                                        <DataGridTextColumn Header="Tanggal Dibuat" Binding="{Binding CreatedAt, StringFormat='{}{0:dd-MM-yyyy}'}" Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: KELOLA USER -->
                <TabItem Header="👥 Kelola Data Pengguna (User)">
                    <Grid ColumnDefinitions="3.5*, 6.5*" Margin="0,12,0,0">
                        <!-- Form User -->
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Form Input Pengguna Sistem" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <Separator Background="#E2E8F0"/>

                                <TextBox x:Name="TxtIdUser" IsVisible="False"/>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Username:" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBox x:Name="TxtUsernameUser" PlaceholderText="Masukkan username..." Height="36"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Password:" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBox x:Name="TxtPasswordUser" PlaceholderText="Masukkan password..." Height="36"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Nama Lengkap:" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBox x:Name="TxtNamaUser" PlaceholderText="Masukkan nama lengkap..." Height="36"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Role Pengguna:" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                    <ComboBox x:Name="CbRoleUser" Height="36" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="admin"/>
                                        <ComboBoxItem Content="kasir"/>
                                        <ComboBoxItem Content="owner"/>
                                    </ComboBox>
                                </StackPanel>

                                <TextBlock x:Name="TxtStatusUser" Text="" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" Margin="0,6,0,0">
                                    <Button Grid.Row="0" Grid.Column="0" Content="💾 Simpan Baru" Click="BtnSimpanUser_Click" Background="#16A34A" Foreground="White" FontWeight="Bold" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,6" CornerRadius="4"/>
                                    <Button Grid.Row="0" Grid.Column="1" Content="✏️ Update" Click="BtnUpdateUser_Click" Background="#D97706" Foreground="White" FontWeight="Bold" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,6" CornerRadius="4"/>
                                    <Button Grid.Row="1" Grid.Column="0" Content="🗑️ Nonaktifkan" Click="BtnHapusUser_Click" Background="#DC2626" Foreground="White" FontWeight="Bold" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" CornerRadius="4"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="🔄 Reset" Click="BtnResetUser_Click" Background="#64748B" Foreground="White" FontWeight="SemiBold" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0" CornerRadius="4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Tabel User -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Daftar Pengguna Sistem (Klik baris tabel untuk edit)" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                                <DataGrid x:Name="DgAdminUsers" Height="470" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgAdminUsers_SelectionChanged" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                                        <DataGridTextColumn Header="Nama Lengkap" Binding="{Binding Nama}" Width="*"/>
                                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                                        <DataGridTextColumn Header="Tanggal Dibuat" Binding="{Binding CreatedAt, StringFormat='{}{0:dd-MM-yyyy}'}" Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
